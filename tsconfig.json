{
  "compilerOptions": {
    "target": "es5",
    "module": "commonjs",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": ["dom", "es2015"]
  },
  "exclude": [
    "node_modules",
    "library",
    "local",
    "temp",
    "build"
  ]
}
